/* ============================================================
   后台管理页共享样式 · 田园绿设计系统 v2
   用法：页面 wxss 顶部 @import "/styles/crud.wxss";
   ============================================================ */

page {
  background: transparent;
}

/* ================= 列表模板 ================= */
.goodsClassify-container {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.goodsClassify-container .content {
  padding-bottom: 160rpx;
}

/* 搜索栏 */
.list-box .search {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: var(--shadow-sm);
  transition: box-shadow var(--dur-base) ease;
}

.search-inp-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--green-50);
  border-radius: var(--radius-full);
  padding: 0 28rpx;
  height: 72rpx;
  transition: all var(--dur-fast) ease;
}

.search-inp-box:focus-within {
  background: #ffffff;
  box-shadow: 0 0 0 4rpx var(--green-200);
}

.search-inp-box text {
  font-size: 30rpx;
  color: var(--ink-3);
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.searchBtn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 36rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--green-600), var(--green-800));
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: var(--shadow-green);
  transition: all var(--dur-fast) ease;
}

.searchBtn:active {
  transform: scale(0.94);
  opacity: 0.9;
}

/* 两列网格 */
.goodsList-box {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 24rpx;
}

.goods-item {
  width: 340rpx;
  background: #ffffff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  margin-bottom: 20rpx;
  overflow: hidden;
  transition: transform var(--dur-base) cubic-bezier(0.22, 1, 0.36, 1),
              box-shadow var(--dur-base) ease;
}

.goods-item:active {
  transform: translateY(-2rpx) scale(0.98);
  box-shadow: var(--shadow-sm);
}

.goods-img {
  width: 340rpx;
  height: 340rpx;
  background: var(--green-50);
  display: block;
  transition: transform 0.4s ease;
}

.goods-item:active .goods-img {
  transform: scale(1.04);
}

/* 卡片内操作区 */
.goods-item .operate-box,
.goods-item .operate-shangpin {
  display: flex;
  border-top: 1rpx solid var(--green-50);
}

.goods-item .edit-box,
.goods-item .delete-box {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  font-size: 26rpx;
  transition: background var(--dur-fast) ease;
}

.goods-item .edit-box {
  color: var(--green-700);
  border-right: 1rpx solid var(--green-50);
}

.goods-item .delete-box {
  color: var(--danger);
}

.edit-icons,
.del-icons {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.edit-box:active,
.delete-box:active {
  background: var(--green-50);
}

/* 新增按钮 */
.add-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--green-600), var(--green-800));
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-green);
  z-index: 50;
  transition: all var(--dur-fast) ease;
}

.add-btn::after {
  border: none;
}

.add-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* ================= 表单模板 ================= */
.update-container,
.register-container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.form-box,
.userInfo-from {
  background: #ffffff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: 8rpx 28rpx;
  transition: box-shadow var(--dur-base) ease;
}

.item-box {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--green-50);
}

.item-box:last-child {
  border-bottom: none;
}

.item-label {
  flex-shrink: 0;
  width: 180rpx;
  font-size: 28rpx;
  color: var(--ink-2);
}

.item-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  text-align: right;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  background: var(--green-50);
  margin-left: auto;
}

.down-item-picker {
  flex: 1;
}

.down-item-picker-text {
  font-size: 28rpx;
  color: var(--ink);
  text-align: right;
}

/* 表单按钮区 */
.btn-box {
  margin-top: 40rpx;
}

.submit-btn,
.save-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--green-600), var(--green-800));
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-green);
  transition: all var(--dur-fast) ease;
}

.submit-btn::after,
.save-btn::after {
  border: none;
}

.quite-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 20rpx;
  border-radius: var(--radius-full);
  background: #ffffff;
  color: var(--ink-2);
  font-size: 30rpx;
  border: 2rpx solid var(--green-100);
  transition: all var(--dur-fast) ease;
}

.quite-btn::after {
  border: none;
}

.quite-btn:active {
  background: var(--green-50);
  transform: scale(0.98);
}

.submit-btn:active,
.save-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* ================= 详情模板 ================= */
.detail-container {
  padding-bottom: 140rpx;
  position: relative;
  z-index: 1;
}

.detail-container .swiper {
  width: 100%;
  height: 560rpx;
  background: #ffffff;
}

.detail-container .swiper-item {
  width: 100%;
  height: 560rpx;
  position: relative;
}

.detail-container .swiper-img {
  width: 100%;
  height: 560rpx;
}

.detail-container .detail-box {
  position: relative;
  margin: -32rpx 24rpx 0;
  background: #ffffff;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  padding: 32rpx 28rpx;
}

.detail-container .detail-item-box {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--green-50);
}

.detail-container .detail-item-box:last-child {
  border-bottom: none;
}

.detail-container .detail-item-label {
  flex-shrink: 0;
  width: 170rpx;
  font-size: 26rpx;
  color: var(--ink-3);
}

.detail-container .detail-item-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.5;
  word-break: break-all;
}

.detail-container .detail-detail-img-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
}

/* 详情底部操作栏 */
.detail-container .operate-box {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 -8rpx 32rpx rgba(46, 92, 56, 0.10);
}

.detail-container .operate-box button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 600;
  margin: 0;
  padding: 0;
  background: linear-gradient(135deg, var(--green-600), var(--green-800));
  color: #ffffff;
  box-shadow: var(--shadow-green);
  transition: all var(--dur-fast) ease;
}

.detail-container .operate-box button::after {
  border: none;
}

.detail-container .operate-box button:active {
  transform: scale(0.95);
  opacity: 0.9;
}
