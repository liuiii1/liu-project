/* 写评价页 · 田园绿主题 */
@import "/styles/crud.wxss";

page {
    background: var(--bg);
}

.comment-page {
    min-height: 100vh;
    padding: 24rpx;
    padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
    box-sizing: border-box;
}

.comment-card {
    background: #ffffff;
    border-radius: 24rpx;
    box-shadow: 0 8rpx 28rpx rgba(46, 92, 56, 0.07);
    padding: 32rpx 28rpx;
}

.card-header {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
    margin-bottom: 24rpx;
    padding-bottom: 24rpx;
    border-bottom: 1rpx solid var(--line);
}

.header-title {
    font-size: 34rpx;
    font-weight: 700;
    color: var(--ink);
}

.header-hint {
    font-size: 24rpx;
    color: var(--ink-3);
}

/* 上限提示 */
.limit-tip {
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
    padding: 20rpx 24rpx;
    background: #fff7e6;
    border-radius: 16rpx;
    margin-bottom: 24rpx;
    border: 1rpx solid #ffd591;
}

.limit-icon {
    font-size: 32rpx;
    flex-shrink: 0;
}

.limit-text {
    flex: 1;
    font-size: 26rpx;
    color: #d46b08;
    line-height: 1.6;
}

.editor-wrapper {
    min-height: 400rpx;
}

.comment-editor {
    width: 100%;
}

/* 提交按钮 */
.submit-area {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
    background: #ffffff;
    box-shadow: 0 -4rpx 20rpx rgba(46, 92, 56, 0.06);
}

.submit-btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    border-radius: 999rpx;
    background: linear-gradient(135deg, var(--green-500), var(--green-700));
    color: #ffffff !important;
    font-size: 30rpx;
    font-weight: 600;
    border: none;
    box-shadow: 0 12rpx 28rpx rgba(47, 122, 61, 0.28);
}

.submit-btn.disabled {
    background: #cccccc !important;
    color: #ffffff !important;
    box-shadow: none;
}

.submit-btn::after {
    border: none;
}
