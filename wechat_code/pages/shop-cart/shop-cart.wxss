/* 购物车页 - 可靠简洁版 */
.cart-container {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: #f7f9f6;
}

.cart-list {
  padding: 20rpx 24rpx;
}

/* 空状态 */
.cart-empty {
  padding: 200rpx 0;
  text-align: center;
}
.cart-empty .empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 商品卡片 */
.product-box {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.product-card {
  display: flex;
  align-items: center;
}

/* 复选框 */
.checkbox-box {
  margin-right: 20rpx;
  flex-shrink: 0;
}
.custom-checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #b0c4a6;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.custom-checkbox.checked {
  background: #2f7a3d;
  border-color: #2f7a3d;
}
.custom-checkbox text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

/* 图片 */
.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eaf0e4;
  flex-shrink: 0;
}

/* 信息 */
.product-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 160rpx;
}
.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3e2d;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.goods-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #e67e22;
}
.price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #888;
  margin-left: 4rpx;
}

/* 数量 + 删除 条 */
.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}

.num-control {
  display: flex;
  align-items: center;
}
.num-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 34rpx;
  color: #2f7a3d;
  font-weight: 600;
  background: #eaf0e4;
  border-radius: 50%;
}
.num-btn:active {
  background: #d4e2cc;
}
.num-val {
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #2d3e2d;
  font-weight: 600;
}

.delete-btn {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #fff;
  background: #e74c3c;
  border-radius: 24rpx;
}
.delete-btn:active {
  background: #c0392b;
}

/* 底部结算栏 */
.cart-fixbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
}
.allSelect {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}
.allSelect-text {
  font-size: 28rpx;
  color: #666;
  margin-left: 12rpx;
}
.count-area {
  flex: 1;
  display: flex;
  align-items: baseline;
}
.count-label {
  font-size: 26rpx;
  color: #666;
}
.count-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #e67e22;
}
.settle-btn {
  flex-shrink: 0;
  padding: 18rpx 36rpx;
  background: #2f7a3d;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
}
.settle-btn:active {
  background: #246030;
}
