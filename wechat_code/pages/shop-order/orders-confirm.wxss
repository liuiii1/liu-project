/* ============================================================
   确认订单页 · 田园绿设计系统
   ============================================================ */
page {
  background: var(--bg);
}
.submit-container {
  padding-bottom: 180rpx;
}
.content {
  padding: 24rpx;
}
.address {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(46, 92, 56, 0.07);
  padding: 28rpx;
  margin-bottom: 24rpx;
  position: relative;
}
.address::before {
  content: '';
  position: absolute;
  left: 0;
  top: 36rpx;
  width: 8rpx;
  height: 60rpx;
  border-radius: 6rpx;
  background: var(--green-700);
}
.address-info > view {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 600;
}
.address-edit {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
}
.nodata {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 28rpx;
  text-align: center;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}
.shop-list {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(46, 92, 56, 0.07);
  padding: 28rpx;
}
.shop-list > view:first-child {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  padding: 0 0 20rpx;
}
.tab-header {
  display: flex;
  align-items: center;
  background: var(--green-50);
  border-radius: 12rpx;
  padding: 16rpx 0;
  font-size: 22rpx;
  color: var(--ink-2);
  text-align: center;
}
.tab-header > view {
  flex: 1;
}
.tab-header > view:first-child {
  flex: 1.6;
}
.shop-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f6f0;
  font-size: 24rpx;
  color: var(--ink-2);
  text-align: center;
}
.shop-item > view,
.shop-item > text {
  flex: 1;
  min-width: 0;
}
.goodname {
  flex: 1.6 !important;
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 600;
  padding-right: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shop-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--green-50);
}
.item_price {
  color: var(--price);
  font-weight: 600;
}
.item_price .price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-2);
  margin-left: 4rpx;
}
.buynumber {
  color: var(--ink-3);
}
.total {
  color: var(--price);
  font-weight: 600;
}
.remark {
  width: 100%;
  height: 120rpx;
  background: var(--green-50);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
}
.total-box {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 24rpx 0 4rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.pay-box {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 32rpx rgba(46, 92, 56, 0.10);
  z-index: 99;
  display: flex;
}
.pay-box button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.pay-box button::after {
  border: none;
}
.pay-box button + button {
  margin-left: 24rpx;
}
.pay-box .btn-later {
  background: #ffffff;
  color: var(--green-700);
  border: 2rpx solid var(--green-700);
}
.pay-box .btn-pay {
  background: var(--green-700);
  color: #ffffff;
}
