/* ============================================================
   物流跟踪页 · 田园绿设计系统
   ============================================================ */
page {
  background: var(--bg);
}
.outerBox {
  padding: 24rpx;
}
.navBox {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #358a48, #2f7a3d);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(47, 122, 61, 0.25);
  padding: 32rpx 28rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
}
.navLeftBox {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.navLeftBox > view:first-child {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 36rpx;
  margin-right: 8rpx;
}
.navLeftBox > view:nth-child(2) {
  font-size: 30rpx;
  font-weight: 700;
}
.navLeftBox > view:nth-child(3) {
  font-size: 22rpx;
  opacity: .8;
}
.navRightBox {
  font-size: 22rpx;
  opacity: .85;
}
.contantBox {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(46, 92, 56, 0.07);
  padding: 12rpx 28rpx;
}
.itemBox {
  display: flex;
  align-items: stretch;
}
.itemLeftBox {
  width: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}
.lineBox {
  flex: 1;
  width: 4rpx;
  display: flex;
  flex-direction: column;
}
.topLineBox,
.bomLineBox {
  width: 4rpx;
  background: #dbe6d6;
}
.topLineBox {
  height: 40rpx;
}
.bomLineBox {
  flex: 1;
}
.newestIconBox {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--green-700);
  border: 6rpx solid #e7f2e0;
  box-sizing: border-box;
  margin: 14rpx 0;
}
.dotBox {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #c5d4bf;
  margin: 20rpx 0;
}
.rightBigBox {
  flex: 1;
  padding: 20rpx 0 28rpx 16rpx;
  font-size: 27rpx;
  color: var(--ink);
  line-height: 1.6;
  font-weight: 500;
}
.timeBox {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--green-700);
  font-weight: 400;
}
.oldTxtBox {
  color: var(--ink-3);
  font-weight: 400;
}
.oldTxtBox .timeBox {
  color: #b3bfb1;
}
.notBox {
  padding: 160rpx 0;
  text-align: center;
  color: var(--ink-3);
  font-size: 28rpx;
}
