/* ============================================================
   订单列表页 · 田园绿设计系统
   ============================================================ */
page {
  background: var(--bg);
  height: 100%;
}
.order-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* ===== Tab 栏 ===== */
.tabs-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 0 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(46, 92, 56, 0.06);
  position: relative;
  z-index: 10;
  flex-shrink: 0;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0 20rpx;
  position: relative;
  font-size: 28rpx;
  color: var(--ink-2);
  font-weight: 500;
}
.tab-item.active {
  color: var(--green-700);
  font-weight: 600;
}
.tab-underline {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--green-700);
  opacity: 0;
  transition: opacity 0.2s;
}
.tab-item.active .tab-underline {
  opacity: 1;
}

/* ===== 滚动区域 ===== */
.order-scroll {
  flex: 1;
  height: 0; /* flex 子项需要 height:0 才能正确撑满 */
  padding: 16rpx 0 32rpx;
  box-sizing: border-box;
}
.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: var(--ink-3);
}

/* ===== 订单卡片 ===== */
.goods-item {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(46, 92, 56, 0.06);
  margin: 16rpx 24rpx;
  padding: 24rpx 28rpx;
}
.status-orderId {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line);
  gap: 12rpx;
}
.text-red {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--price);
}
.text-green {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--green-700);
}
.orderId {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink-3);
}
.order-content {
  padding-top: 20rpx;
}
.order-model {
  display: flex;
  align-items: center;
}
.order-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: var(--green-50);
  flex-shrink: 0;
}
.order-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.order-info .name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.buy-num {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.order-info .price {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--price);
}
.order-info .price .price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-2);
  margin-left: 4rpx;
}
.user-info {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--green-50);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.9;
}
.operate-btn {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}
.operate-btn .btn {
  padding: 0 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--green-300);
  color: var(--green-700);
  background: #ffffff;
  text-align: center;
}
.operate-btn .btn-primary {
  background: linear-gradient(135deg, var(--green-500), var(--green-700));
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(47, 122, 61, 0.25);
}
.operate-btn .btn:active {
  opacity: .8;
}

/* ============================================================
   退款/退货理由弹窗
   ============================================================ */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-dialog {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-sizing: border-box;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  color: #333;
  margin-bottom: 30rpx;
}
.modal-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  background: #fafafa;
}
.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}
.modal-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  font-size: 28rpx;
}
.modal-btn-cancel {
  background: #f0f0f0;
  color: #666;
}
.modal-btn-confirm {
  background: linear-gradient(135deg, #b7d573, #7ba347);
  color: #fff;
}
