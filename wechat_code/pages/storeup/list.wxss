/* ============================================================
   我的收藏页 · 田园绿设计系统 v2
   ============================================================ */

.storeup-container {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.content {
  padding-bottom: 60rpx;
}

/* ---------- 搜索栏 ---------- */
.search-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: var(--shadow-sm);
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--green-50);
  border-radius: var(--radius-full);
  padding: 0 28rpx;
  height: 76rpx;
  transition: all var(--dur-fast) ease;
}

.search-input-wrap:focus-within {
  background: #ffffff;
  box-shadow: 0 0 0 4rpx var(--green-200);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.search-placeholder {
  color: var(--ink-3);
}

.search-btn {
  flex-shrink: 0;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 36rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--green-500), var(--green-800));
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: var(--shadow-green);
  transition: all var(--dur-fast) ease;
}

.search-btn:active {
  transform: scale(0.94);
  opacity: 0.9;
}

/* ---------- 区块标题 ---------- */
.section-header {
  padding: 28rpx 28rpx 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
}

.title-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

.title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1;
}

.title-count {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-left: 12rpx;
  font-weight: 400;
  background: var(--green-50);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  line-height: 1;
}

/* ---------- 商品网格 ---------- */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
}

.goods-card {
  width: 48%;
  background: #ffffff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  margin-bottom: 20rpx;
  transition: all var(--dur-base) cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
}

.goods-card:active {
  transform: translateY(-4rpx) scale(0.98);
  box-shadow: var(--shadow-lg);
}

/* 图片区 */
.card-img-wrap {
  position: relative;
  width: 100%;
  height: 240rpx;
  overflow: hidden;
  background: var(--green-50);
}

.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--dur-slow) ease;
}

.goods-card:active .card-img {
  transform: scale(1.06);
}

/* 收藏心形徽章 */
.fav-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  z-index: 2;
}

.fav-icon {
  font-size: 28rpx;
  color: #e74c3c;
  line-height: 1;
}

/* 商品分类标签 */
.card-tag {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  padding: 8rpx 18rpx;
  background: linear-gradient(135deg, rgba(47, 122, 61, 0.9), rgba(74, 157, 91, 0.9));
  backdrop-filter: blur(10rpx);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 500;
  border-radius: var(--radius-full);
  z-index: 2;
  line-height: 1;
}

/* 信息区 */
.card-info {
  padding: 14rpx 18rpx 18rpx;
}

.card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 10rpx;
}

.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--price);
  margin-right: 2rpx;
}

.price-num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--price);
  line-height: 1;
}

.price-na {
  font-size: 24rpx;
  color: var(--green-600);
  font-weight: 500;
}

/* 取消收藏按钮 */
.remove-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--green-50);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--dur-fast) ease;
}

.remove-btn:active {
  background: #ffe5e5;
  transform: scale(0.9);
}

.remove-icon {
  font-size: 28rpx;
  color: var(--ink-3);
  line-height: 1;
  font-weight: 300;
}

.remove-btn:active .remove-icon {
  color: #e74c3c;
}

/* ---------- 空状态 ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0 200rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  animation: floatLeaf 3s ease-in-out infinite;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--ink-3);
}

@keyframes floatLeaf {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}
