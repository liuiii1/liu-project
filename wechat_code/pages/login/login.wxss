/* ============================================================
   登录页 · 田园绿设计系统 v2
   ============================================================ */
.login-container {
  min-height: 100vh;
  background:
    radial-gradient(ellipse 80% 40% at 50% 0%, rgba(183, 213, 115, 0.35) 0%, transparent 60%),
    radial-gradient(ellipse 60% 50% at 100% 30%, rgba(124, 191, 139, 0.25) 0%, transparent 50%),
    linear-gradient(170deg, #358a48 0%, #2f7a3d 45%, #256b33 100%);
  padding: 140rpx 48rpx 60rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* 装饰性浮动元素 */
.login-container::before,
.login-container::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}

.login-container::before {
  width: 200rpx;
  height: 200rpx;
  background: var(--lime);
  top: 10%;
  right: -60rpx;
  filter: blur(20rpx);
}

.login-container::after {
  width: 160rpx;
  height: 160rpx;
  background: var(--green-300);
  bottom: 20%;
  left: -40rpx;
  filter: blur(16rpx);
}

.content {
  position: relative;
  z-index: 1;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 24rpx 60rpx rgba(20, 60, 30, 0.3);
  animation: fadeInUp var(--dur-slow) cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 头像 */
.avatar-box {
  display: flex;
  justify-content: center;
  margin-bottom: 36rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--green-100);
  content: '';
}

.avatar-box image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(47, 122, 61, 0.2);
}

/* 输入框 */
.box {
  display: flex;
  align-items: center;
  height: 96rpx;
  background: var(--green-50);
  border-radius: var(--radius-full);
  padding: 0 36rpx;
  margin-bottom: 24rpx;
  transition: all var(--dur-fast) ease;
}

.box:focus-within {
  background: #ffffff;
  box-shadow: 0 0 0 4rpx var(--green-200);
}

.box input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

/* 身份选择 */
.section {
  margin-bottom: 24rpx;
}

.picker-text {
  height: 96rpx;
  line-height: 96rpx;
  background: var(--green-50);
  border-radius: var(--radius-full);
  padding: 0 36rpx;
  font-size: 28rpx;
  color: var(--ink-2);
  position: relative;
  transition: all var(--dur-fast) ease;
}

.picker-text:active {
  background: var(--green-100);
}

.picker-text::after {
  content: '▼';
  position: absolute;
  right: 36rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: var(--ink-3);
  transition: transform var(--dur-base) ease;
}

/* 登录按钮 */
.login-btn {
  margin-top: 16rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--green-500), var(--green-800));
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-green);
  transition: all var(--dur-fast) ease;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 注册入口 */
.box2 {
  margin-top: 32rpx;
  text-align: center;
}

.register-btn {
  display: inline-block;
  font-size: 26rpx;
  color: var(--green-700);
  font-weight: 500;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  transition: all var(--dur-fast) ease;
}

.register-btn:active {
  background: rgba(47, 122, 61, 0.1);
  transform: scale(0.95);
}
