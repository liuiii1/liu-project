/* ============================================================
   农产品列表页 · 田园绿设计系统
   ============================================================ */
.agri-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

/* ---------- 顶部搜索 ---------- */
.agri-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(46, 92, 56, 0.06);
  flex-shrink: 0;
}
.search-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--green-50);
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 72rpx;
}
.search-icon {
  font-size: 28rpx;
  color: var(--ink-3);
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.search-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: var(--green-700);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
.search-btn:active {
  opacity: .85;
}

/* ---------- 主体 ---------- */
.agri-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧分类 */
.agri-sidebar {
  width: 200rpx;
  background: #ffffff;
  flex-shrink: 0;
}
.side-item {
  padding: 28rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-2);
  position: relative;
  border-left: 6rpx solid transparent;
  transition: all .2s ease;
}
.side-item.active {
  color: var(--green-700);
  font-weight: 700;
  background: var(--green-50);
  border-left-color: var(--green-700);
}

/* 右侧内容 */
.agri-content {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}
.cat-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}
.cat-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}
.cat-count {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 商品卡片 */
.prod-card {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(46, 92, 56, 0.06);
  transition: transform .18s ease;
}
.prod-card:active {
  transform: scale(.98);
}
.prod-img {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: var(--green-50);
}
.prod-info {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}
.prod-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.prod-origin {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.prod-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: auto;
}
.prod-price {
  display: flex;
  align-items: baseline;
}
.price-symbol {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--price);
}
.price-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--price);
  margin-left: 2rpx;
  line-height: 1;
}
.price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-2);
  margin-left: 4rpx;
  align-self: baseline;
}
.prod-vip {
  background: linear-gradient(90deg, #e9d38a, #c99a2e);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* 新增按钮 */
.agri-add-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: var(--green-700);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(47, 122, 61, 0.25);
}
.agri-add-btn::after {
  border: none;
}
