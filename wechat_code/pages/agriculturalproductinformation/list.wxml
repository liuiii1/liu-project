<wxs src="../../utils/formatMoney.wxs" module="fm" />
<view class="agri-page">

  <!-- 顶部搜索 -->
  <view class="agri-search">
    <view class="search-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" model:value="{{productname}}" placeholder="搜索商品" bindconfirm="search" />
    </view>
    <view class="search-btn" bind:tap="search">搜索</view>
  </view>

  <!-- 主体：左侧分类栏 + 右侧商品列表 -->
  <view class="agri-body">

    <!-- 左侧分类导航 -->
    <scroll-view scroll-y="true" class="agri-sidebar">
      <view
        wx:for="{{silderList}}"
        wx:key="index"
        class="side-item {{activeIndex == index ? 'active' : ''}}"
        bindtap="handleTabClick"
        data-index="{{index}}"
        data-productcategory="{{item.productcategory}}">
        {{item.productcategory}}
      </view>
    </scroll-view>

    <!-- 右侧商品区域 -->
    <scroll-view scroll-y="true" class="agri-content">

      <!-- 分类标题 + 商品数 -->
      <view class="cat-header">
        <text class="cat-name">{{silderList[activeIndex] && silderList[activeIndex].productcategory}}</text>
        <text class="cat-count">共 {{goodsListData.length}} 个商品</text>
      </view>

      <!-- 商品卡片列表 -->
      <view
        wx:for="{{goodsListData}}"
        wx:key="id"
        class="prod-card"
        bindtap="detailBtn"
        data-item="{{item}}">

        <image
          class="prod-img"
          src="{{baseURL+item.image}}"
          mode="aspectFill" />

        <view class="prod-info">
          <view class="prod-name">{{item.productname}}</view>
          <view class="prod-origin" wx:if="{{item.placeofproduction}}">
            📍 {{item.placeofproduction}}
          </view>
          <view class="prod-bottom">
            <view class="prod-price">
              <text class="price-symbol">¥</text>
              <text class="price-num">{{fm.f(item.price)}}</text>
              <text class="price-unit">/斤</text>
            </view>

          </view>
        </view>

      </view>

      <!-- 空状态 -->
      <view wx:if="{{goodsListData.length === 0}}" class="empty-tip">
        <text>该分类暂无商品 🌱</text>
      </view>

      <!-- 新增按钮（仅供应商/管理员） -->
      <button class="agri-add-btn" wx:if="{{addAuth}}" bind:tap="addTap">+ 新增商品</button>

    </scroll-view>

  </view>

</view>
