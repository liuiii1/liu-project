/* 地址编辑页 - 田园绿 · 不使用 CSS 变量 */
page {
  background: #f4f7f2;
}
.addr-detail-page {
  min-height: 100vh;
  padding: 24rpx;
}

/* ========== 表单卡片 ========== */
.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 12rpx 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f2f6f0;
}
.form-item:last-child {
  border-bottom: none;
}

/* label */
.form-label {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  width: 180rpx;
  font-size: 28rpx;
  color: #555;
}
.label-ico {
  font-size: 30rpx;
  margin-right: 10rpx;
}

/* input */
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #2d3e2d;
  text-align: right;
}

/* textarea 整行 */
.form-item-col {
  flex-direction: column;
  align-items: flex-start;
}
.form-item-col .form-label {
  width: 100%;
  margin-bottom: 16rpx;
}
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #2d3e2d;
  padding: 16rpx;
  background: #f7f9f6;
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* ========== 设为默认开关 ========== */
.default-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}
.default-left {
  display: flex;
  align-items: center;
}
.default-ico {
  font-size: 30rpx;
  margin-right: 12rpx;
}
.default-text {
  font-size: 28rpx;
  color: #555;
}

/* ========== 保存按钮 ========== */
.save-btn-wrap {
  margin-top: 48rpx;
  padding: 0 12rpx;
}
.save-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: #2f7a3d;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  box-shadow: 0 10rpx 24rpx rgba(47, 122, 61, 0.25);
}
.save-btn:active {
  background: #246030;
}
