/* 收货地址列表 - 田园绿 · 不使用 CSS 变量 */
page {
  background: #f4f7f2;
}

.addr-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* ========== 空状态 ========== */
.addr-empty {
  padding: 200rpx 48rpx;
  text-align: center;
}
.addr-empty .empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.addr-empty .empty-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #2d3e2d;
  margin-bottom: 12rpx;
}
.addr-empty .empty-hint {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 48rpx;
}
.empty-add-btn {
  display: inline-block;
  padding: 22rpx 60rpx;
  background: #2f7a3d;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(47, 122, 61, 0.25);
}
.empty-add-btn:active {
  background: #246030;
}

/* ========== 列表 ========== */
.addr-list {
  padding: 24rpx 24rpx 0;
}
.addr-count {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

/* ========== 地址卡片 ========== */
.addr-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 左侧定位图标列 */
.addr-icon-col {
  display: flex;
  justify-content: center;
  width: 64rpx;
  flex-shrink: 0;
  padding-top: 8rpx;
}
.addr-pin {
  font-size: 44rpx;
}

/* 右侧内容 */
.addr-content {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

/* 姓名 + 电话 + 默认标签 */
.addr-top {
  margin-bottom: 12rpx;
}
.addr-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.addr-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d3e2d;
}
.addr-phone {
  font-size: 28rpx;
  color: #666;
  margin-left: 20rpx;
}
.addr-default-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #2f7a3d;
  background: #eaf0e4;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
  font-weight: 500;
}

/* 详细地址 */
.addr-detail {
  font-size: 28rpx;
  color: #555;
  line-height: 1.5;
  margin-bottom: 18rpx;
  word-break: break-all;
}

/* 操作条 */
.addr-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 18rpx;
  border-top: 1rpx solid #eee;
}

.addr-set-default {
  display: flex;
  align-items: center;
}
.radio {
  font-size: 32rpx;
  color: #bbb;
  margin-right: 8rpx;
}
.radio.checked {
  color: #2f7a3d;
}
.set-default-text {
  font-size: 26rpx;
  color: #666;
}
.set-default-text:active {
  color: #2f7a3d;
}

.addr-action-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.addr-btn {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
}
.addr-btn:active {
  background: #f5f5f5;
}
.addr-btn .btn-ico {
  font-size: 26rpx;
  margin-right: 4rpx;
}
.addr-del {
  color: #e74c3c;
}
.addr-del:active {
  background: #fdecea;
}

/* ========== 底部固定新增 ========== */
.addr-fixed-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}
.addr-add-fixed {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: #2f7a3d;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  box-shadow: 0 10rpx 24rpx rgba(47, 122, 61, 0.25);
}
.addr-add-fixed:active {
  background: #246030;
}
.addr-add-fixed .add-plus {
  font-size: 36rpx;
  font-weight: 400;
  margin-right: 8rpx;
}
