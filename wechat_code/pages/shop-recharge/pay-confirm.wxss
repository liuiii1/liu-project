/* ============================================================
   支付确认页 · 田园绿设计系统
   ============================================================ */
page {
  background: var(--bg);
}
.pay-container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.pay-content {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(46, 92, 56, 0.07);
  padding: 32rpx 28rpx;
}
.pay-list {
  display: flex;
  flex-direction: column;
}
.pay-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid #f2f6f0;
}
.pay-item:last-child {
  border-bottom: none;
}
.pay-item .img {
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
}
.pay-item radio {
  margin-left: auto;
}
.pay-content > button {
  margin-top: 32rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: var(--green-700) !important;
  color: #ffffff !important;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(47, 122, 61, 0.28);
}
.pay-content > button::after {
  border: none;
}
