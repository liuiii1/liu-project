@import '../../static/iconfig/reply/iconfont.wxss';

/* ============================================================
   评论编辑页 · 田园绿设计系统
   ============================================================ */
page {
  background: var(--bg);
}
.container {
  padding: 24rpx;
}
.toolbar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 8rpx 28rpx rgba(46, 92, 56, 0.07);
  padding: 16rpx 24rpx;
}
.toolbar i {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--ink-2);
  border-radius: 12rpx;
  font-style: normal;
}
.toolbar i:active {
  background: var(--green-50);
}
.toolbar .ql-active {
  color: var(--green-700);
  background: var(--green-100);
}
.page-body {
  background: #ffffff;
  border-radius: 0 0 20rpx 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(46, 92, 56, 0.07);
  padding: 24rpx;
}
.wrapper {
  margin-bottom: 32rpx;
}
.ql-container {
  min-height: 420rpx;
  background: var(--green-50);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--ink);
}
.page-body button {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: var(--green-700) !important;
  color: #ffffff !important;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(47, 122, 61, 0.28);
}
.page-body button::after {
  border: none;
}
