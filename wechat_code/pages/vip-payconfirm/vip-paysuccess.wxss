/* ============================================================
   会员购买成功页 · 田园绿设计系统
   ============================================================ */
page {
  background: var(--bg);
}
.content {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.content::before {
  content: '\2713';
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  text-align: center;
  border-radius: 50%;
  background: #e7f2e0;
  color: var(--green-700);
  font-size: 80rpx;
  font-weight: 700;
  margin-bottom: 36rpx;
}
.text-reset {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
}
