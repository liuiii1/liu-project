/* ============================================================
   用户注册页 · 田园绿设计系统
   ============================================================ */
.register-container {
  min-height: 100vh;
  background: linear-gradient(170deg, #358a48 0%, #2f7a3d 45%, #256b33 100%);
  padding: 80rpx 48rpx 60rpx;
  box-sizing: border-box;
}
.content {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 24rpx 60rpx rgba(20, 60, 30, 0.25);
}
.avatar-box {
  display: flex;
  justify-content: center;
  margin-bottom: 36rpx;
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--green-100);
}
.box {
  display: flex;
  align-items: center;
  height: 96rpx;
  background: var(--green-50);
  border-radius: 999rpx;
  padding: 0 36rpx;
  margin-bottom: 24rpx;
}
.box input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.box-uploadBox {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 12rpx;
}
.upload-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: var(--green-50);
  border: 2rpx dashed var(--green-500);
}
.upload-text {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.item-box {
  display: flex;
  align-items: center;
  height: 96rpx;
  background: var(--green-50);
  border-radius: 999rpx;
  padding: 0 36rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.item-box picker {
  flex: 1;
}
.item-box picker input {
  width: 100%;
  font-size: 28rpx;
  color: var(--ink);
}
.register-btn {
  margin-top: 20rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: var(--green-700);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(47, 122, 61, 0.28);
}
.register-btn::after {
  border: none;
}
.register-btn:active {
  opacity: .88;
}
