.weui-tabs {
    width: 100%;
    height: 100vh;
    padding-top: 88rpx;
    box-sizing: border-box;
    position: relative;
}

.weui-tabs-bar__wrp {
    width: 100%;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 99;
    background-color: #ffffff;
    padding: 20rpx 0;
    box-sizing: border-box;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.weui-tabs-bar__content {
    width: 100%;
    white-space: nowrap;
    display: flex;
}

.weui-tabs-bar__item {
    flex: 1;
    text-align: center;
}

.weui-tabs-bar__title {
    display: inline-block;
    padding: 12rpx 8rpx;
    font-size: 28rpx;
    border-bottom-width: 4rpx;
    border-bottom-style: solid;
    border-bottom-color: transparent;
}

swiper.ref-tabs {
    width: 100%;
    height: 100% !important;
}
